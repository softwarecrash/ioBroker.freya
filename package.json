{
    "name": "iobroker.smartbrain",
    "version": "0.8.0",
    "description": "Learns explainable smart-home patterns and proposes safety-controlled automations",
    "author": {
        "name": "softwarecrash",
        "email": "44615614+softwarecrash@users.noreply.github.com"
    },
    "homepage": "https://github.com/softwarecrash/ioBroker.smartbrain",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "automation",
        "learning",
        "patterns",
        "smart-home",
        "local-first"
    ],
    "repository": {
        "type": "git",
        "url": "git@github.com:softwarecrash/ioBroker.smartbrain.git"
    },
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "suncalc": "^2.0.1"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@tsconfig/node22": "^22.0.6",
        "@types/iobroker": "npm:@iobroker/types@^7.2.2",
        "@types/node": "^20.19.43",
        "nyc": "^18.0.0",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    },
    "main": "build/main.js",
    "files": [
        "admin/**/*.{json,json5,html,css,png,svg,jpg,js}",
        "build/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prebuild": "rimraf build",
        "build": "build-adapter ts",
        "watch": "build-adapter ts --watch",
        "test:ts": "mocha --config test/mocharc.custom.json \"src/**/*.test.ts\"",
        "test:package": "mocha test/package.js --exit",
        "test:checker": "npx --yes @iobroker/repochecker@5.20.13 https://github.com/softwarecrash/ioBroker.smartbrain --local",
        "test:integration": "mocha test/integration.js --exit",
        "test": "npm run test:ts && npm run test:package",
        "check": "tsc --noEmit",
        "check:release": "npm run check && npm test && npm run lint && npm run build && npm run test:checker",
        "coverage": "nyc npm run test:ts",
        "lint": "eslint -c eslint.config.mjs .",
        "translate": "translate-adapter",
        "release": "release-script"
    },
    "nyc": {
        "include": [
            "src/**/*.ts"
        ],
        "exclude": [
            "src/**/*.test.ts"
        ],
        "extension": [
            ".ts"
        ],
        "require": [
            "ts-node/register"
        ],
        "reporter": [
            "text-summary",
            "html"
        ],
        "sourceMap": true,
        "instrument": true
    },
    "bugs": {
        "url": "https://github.com/softwarecrash/ioBroker.smartbrain/issues"
    },
    "readmeFilename": "README.md"
}
