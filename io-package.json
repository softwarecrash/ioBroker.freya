{
    "common": {
        "name": "smartbrain",
        "version": "0.9.0",
        "news": {
            "0.9.0": {
                "en": "Add persistent action correlation and conservative feedback learning",
                "de": "Persistente Aktionskorrelation und konservatives Feedback-Lernen hinzugefügt"
            },
            "0.8.0": {
                "en": "Add isolated optional LLM advisory providers and disclosure previews",
                "de": "Isolierte optionale LLM-Berater und Übertragungsvorschau hinzugefügt"
            },
            "0.7.0": {
                "en": "Add deny-by-default controlled actions with last-moment safety validation",
                "de": "Standardmäßig gesperrte Aktionen mit Sicherheitsprüfung unmittelbar vor Ausführung hinzugefügt"
            },
            "0.6.0": {
                "en": "Add rules-only suggestions, approval lifecycle, and bounded activity auditing",
                "de": "Regelbasierte Vorschläge, Freigabe-Lebenszyklus und begrenztes Aktivitäts-Audit hinzugefügt"
            },
            "0.5.1": {
                "en": "Fix repeated policy-normalization restarts and shutdown races",
                "de": "Wiederholte Policy-Normalisierungs-Neustarts und Shutdown-Rennen behoben"
            },
            "0.5.0": {
                "en": "Add bounded explainable trigger-to-light pattern learning",
                "de": "Begrenztes, erklärbares Lernen von Auslöser-zu-Licht-Mustern hinzugefügt"
            },
            "0.4.1": {
                "en": "List installed getHistory-capable adapter instances in the provider selection",
                "de": "Installierte getHistory-fähige Adapterinstanzen in der Provider-Auswahl auflisten"
            },
            "0.4.0": {
                "en": "Add bounded read-only history providers with live capability detection",
                "de": "Begrenzte schreibgeschützte History-Provider mit Live-Capability-Erkennung hinzugefügt"
            },
            "0.3.0": {
                "en": "Add permission-gated observations with bounded context snapshots and status counters",
                "de": "Berechtigungsgesteuerte Beobachtungen mit begrenzten Kontext-Snapshots und Statuszählern hinzugefügt"
            },
            "0.2.0": {
                "en": "Add synchronized object custom policies and provider-based time and solar context",
                "de": "Synchronisierte Objekt-Einstellungen und Provider-basierten Zeit- und Sonnenkontext hinzugefügt"
            }
        },
        "titleLang": {
            "en": "SmartBrain",
            "de": "SmartBrain"
        },
        "desc": {
            "en": "Learns explainable smart-home patterns and proposes safety-controlled automations",
            "de": "Lernt erklärbare Smart-Home-Muster und schlägt sicherheitsgeprüfte Automatisierungen vor"
        },
        "authors": ["softwarecrash <44615614+softwarecrash@users.noreply.github.com>"],
        "keywords": ["automation", "learning", "patterns", "smart-home", "local-first"],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "icon": "smartbrain.svg",
        "enabled": false,
        "extIcon": "https://raw.githubusercontent.com/softwarecrash/ioBroker.smartbrain/main/admin/smartbrain.svg",
        "readme": "https://github.com/softwarecrash/ioBroker.smartbrain/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "logic",
        "compact": true,
        "connectionType": "local",
        "dataSource": "assumption",
        "dataFolder": "smartbrain.%INSTANCE%",
        "messagebox": true,
        "supportCustoms": true,
        "adminUI": {
            "config": "json"
        },
        "dependencies": [{ "js-controller": ">=6.0.11" }],
        "globalDependencies": [{ "admin": ">=7.6.20" }]
    },
    "native": {
        "autonomyLevel": 0,
        "minimumActionConfidence": 0.7,
        "actionCooldownSeconds": 300,
