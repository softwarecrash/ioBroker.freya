{
    "common": {
        "name": "smartbrain",
        "version": "0.4.0",
        "news": {
            "0.4.0": {
                "en": "Add bounded read-only history providers with live capability detection",
                "de": "Begrenzte schreibgeschützte History-Provider mit Live-Capability-Erkennung hinzugefügt"
            },
            "0.3.0": {
                "en": "Add permission-gated observations with bounded context snapshots and status counters",
                "de": "Berechtigungsgesteuerte Beobachtungen mit begrenzten Kontext-Snapshots und Statuszählern hinzugefügt"
            },
            "0.2.0": {
                "en": "Add synchronized object custom policies and provider-based time and solar context",
                "de": "Synchronisierte Objekt-Einstellungen und Provider-basierten Zeit- und Sonnenkontext hinzugefügt"
            },
            "0.1.0": {
                "en": "Add safe metadata discovery, semantic classification and deny-by-default permissions",
                "de": "Sichere Metadaten-Erkennung, semantische Klassifizierung und standardmäßig verweigerte Berechtigungen hinzugefügt"
            },
            "0.0.1": {
                "en": "Initial read-only adapter skeleton",
                "de": "Initiales schreibgeschütztes Adaptergerüst"
            }
        },
        "titleLang": {
            "en": "SmartBrain",
            "de": "SmartBrain"
        },
        "desc": {
            "en": "Learns explainable smart-home patterns and proposes safety-controlled automations",
            "de": "Lernt erklärbare Smart-Home-Muster und schlägt sicherheitsgeprüfte Automatisierungen vor"
        },
        "authors": ["softwarecrash <44615614+softwarecrash@users.noreply.github.com>"],
        "keywords": ["automation", "learning", "patterns", "smart-home", "local-first"],
        "licenseInformation": {
            "type": "free",
            "license": "MIT"
        },
        "platform": "Javascript/Node.js",
        "icon": "smartbrain.svg",
        "enabled": false,
        "extIcon": "https://raw.githubusercontent.com/softwarecrash/ioBroker.smartbrain/main/admin/smartbrain.svg",
        "readme": "https://github.com/softwarecrash/ioBroker.smartbrain/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "logic",
        "compact": true,
        "connectionType": "local",
        "dataSource": "assumption",
        "dataFolder": "smartbrain.%INSTANCE%",
        "messagebox": true,
        "supportCustoms": true,
        "adminUI": {
            "config": "json"
        },
        "dependencies": [{ "js-controller": ">=6.0.11" }],
        "globalDependencies": [{ "admin": ">=7.6.20" }]
    },
    "native": {
        "autonomyLevel": 0,
        "learningEnabled": false,
        "historyInstance": "none",
        "discoveryEnabled": true,
        "discoveryMaxStates": 20000,
        "statePolicies": [],
        "environmentMappings": [],
        "manualLatitude": null,
        "manualLongitude": null
    },
