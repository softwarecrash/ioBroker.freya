        "news": {
            "0.10.0": {
                "en": "Learn presence-based light on and off patterns with semantic same-room illuminance context",
                "de": "Präsenzbasierte Licht-Ein- und Ausschaltmuster mit semantischem Raum-Helligkeitskontext lernen",
                "ru": "Изучение включения и выключения света по присутствию с учетом освещенности в комнате",
                "pt": "Aprenda padrões de ligar e desligar luz por presença com contexto semântico de iluminação do ambiente",
                "nl": "Leer op aanwezigheid gebaseerde licht-aan- en uitpatronen met semantische kamerverlichting",
                "fr": "Apprentissage de l'allumage et de l'extinction selon la présence avec la luminosité sémantique de la pièce",
                "it": "Apprendimento di accensione e spegnimento in base alla presenza con luminosità semantica della stanza",
                "es": "Aprende patrones de encendido y apagado por presencia con iluminación semántica de la habitación",
                "pl": "Uczenie włączania i wyłączania światła na podstawie obecności i semantycznego oświetlenia pomieszczenia",
                "uk": "Вивчення ввімкнення та вимкнення світла за присутністю з урахуванням освітленості кімнати",
                "zh-cn": "学习基于存在状态的开关灯模式，并使用语义化房间照度上下文"
            },
            "0.9.1": {
                "en": "Add pre-release hardening, complete UI translations, privacy documentation, and package smoke tests",
                "de": "Pre-Release-Härtung, vollständige UI-Übersetzungen, Datenschutzdokumentation und Paket-Smoke-Tests hinzugefügt",
                "ru": "Добавлены усиление предварительной версии, полные переводы интерфейса, документация по конфиденциальности и дымовые тесты пакета",
                "pt": "Adicione proteção de pré-lançamento, traduções completas da interface, documentação de privacidade e testes rápidos do pacote",
                "nl": "Pre-release-hardening, volledige UI-vertalingen, privacydocumentatie en pakket-smoketests toegevoegd",
                "fr": "Ajout du renforcement de préversion, des traductions complètes de l’interface, de la documentation de confidentialité et des tests rapides du paquet",
                "it": "Aggiunti rafforzamento pre-release, traduzioni complete dell'interfaccia, documentazione sulla privacy e smoke test del pacchetto",
                "es": "Se añadieron refuerzo previo al lanzamiento, traducciones completas de la interfaz, documentación de privacidad y pruebas rápidas del paquete",
                "pl": "Dodano utwardzanie przed wydaniem, pełne tłumaczenia interfejsu, dokumentację prywatności i testy dymne pakietu",
                "uk": "Додано посилення перед випуском, повні переклади інтерфейсу, документацію про конфіденційність і димові тести пакета",
                "zh-cn": "添加预发布强化、完整界面翻译、隐私文档和软件包冒烟测试"
            },
            "0.9.0": {
                "en": "Add persistent action correlation and conservative feedback learning",
                "de": "Persistente Aktionskorrelation und konservatives Feedback-Lernen hinzugefügt",
                "ru": "Добавьте постоянную корреляцию действий и консервативное обучение с обратной связью.",
                "pt": "Adicione correlação de ação persistente e aprendizado de feedback conservador",
                "nl": "Voeg aanhoudende actiecorrelatie en conservatief feedbackleren toe",
                "fr": "Ajoutez une corrélation d’actions persistante et un apprentissage par feedback conservateur",
                "it": "Aggiungi correlazione di azioni persistente e apprendimento con feedback conservativo",
                "es": "Agregue correlación de acción persistente y aprendizaje de retroalimentación conservadora",
                "pl": "Dodaj trwałą korelację działań i uczenie się poprzez konserwatywne informacje zwrotne",
                "uk": "Додайте постійну кореляцію дій і консервативне навчання зі зворотним зв’язком",
                "zh-cn": "添加持久动作相关性和保守反馈学习"
            },
            "0.8.0": {
                "en": "Add isolated optional LLM advisory providers and disclosure previews",
                "de": "Isolierte optionale LLM-Berater und Übertragungsvorschau hinzugefügt",
                "ru": "Добавьте отдельных дополнительных поставщиков консультаций LLM и предварительный просмотр раскрытия информации.",
                "pt": "Adicione provedores de consultoria LLM opcionais isolados e visualizações de divulgação",
                "nl": "Voeg geïsoleerde optionele LLM-adviesaanbieders en openbaarmakingsvoorbeelden toe",
                "fr": "Ajoutez des fournisseurs de conseils LLM facultatifs isolés et des aperçus de divulgation",
                "it": "Aggiungi fornitori di consulenza LLM opzionali isolati e anteprime di divulgazione",
                "es": "Agregue proveedores de asesoramiento de LLM opcionales aislados y vistas previas de divulgación",
                "pl": "Dodaj izolowanych opcjonalnych dostawców usług doradczych LLM i podglądy ujawnień",
                "uk": "Додайте окремих факультативних постачальників консультацій LLM і попередній перегляд інформації",
                "zh-cn": "添加独立的可选 LLM 咨询提供商和披露预览"
            },
            "0.7.0": {
                "en": "Add deny-by-default controlled actions with last-moment safety validation",
                "de": "Standardmäßig gesperrte Aktionen mit Sicherheitsprüfung unmittelbar vor Ausführung hinzugefügt",
                "ru": "Добавьте контролируемые действия, запрещенные по умолчанию, с проверкой безопасности в последний момент.",
                "pt": "Adicione ações controladas de negação por padrão com validação de segurança de última hora",
                "nl": "Voeg standaardgestuurde acties toe met veiligheidsvalidatie op het laatste moment",
                "fr": "Ajoutez des actions contrôlées de refus par défaut avec une validation de sécurité au dernier moment",
                "it": "Aggiungi azioni controllate di rifiuto per impostazione predefinita con convalida di sicurezza dell'ultimo momento",
                "es": "Agregue acciones controladas de denegación por defecto con validación de seguridad de último momento",
                "pl": "Dodaj domyślnie kontrolowane akcje typu „odmowa” z weryfikacją bezpieczeństwa w ostatniej chwili",
                "uk": "Додайте контрольовані дії заборони за замовчуванням із перевіркою безпеки в останній момент",
                "zh-cn": "添加带有最后一刻安全验证的默认拒绝受控操作"
            },
            "0.6.0": {
                "en": "Add rules-only suggestions, approval lifecycle, and bounded activity auditing",
                "de": "Regelbasierte Vorschläge, Freigabe-Lebenszyklus und begrenztes Aktivitäts-Audit hinzugefügt",
                "ru": "Добавьте предложения только по правилам, жизненный цикл утверждения и ограниченный аудит действий.",
                "pt": "Adicione sugestões somente de regras, ciclo de vida de aprovação e auditoria de atividades limitadas",
                "nl": "Voeg alleen-regelsuggesties, goedkeuringslevenscyclus en controle van begrensde activiteiten toe",
                "fr": "Ajoutez des suggestions de règles uniquement, un cycle de vie d'approbation et un audit d'activité limité",
                "it": "Aggiungi suggerimenti relativi alle sole regole, ciclo di vita dell'approvazione e controllo delle attività limitate",
                "es": "Agregue sugerencias de solo reglas, ciclo de vida de aprobación y auditoría de actividades limitadas",
                "pl": "Dodaj sugestie dotyczące samych reguł, cykl życia zatwierdzenia i ograniczoną inspekcję działań",
                "uk": "Додайте лише пропозиції щодо правил, життєвий цикл затвердження та обмежений аудит активності",
                "zh-cn": "添加仅规则建议、批准生命周期和有界活动审核"
            },
            "0.5.1": {
                "en": "Fix repeated policy-normalization restarts and shutdown races",
                "de": "Wiederholte Policy-Normalisierungs-Neustarts und Shutdown-Rennen behoben",
                "ru": "Исправление повторяющихся перезапусков нормализации политики и гонок при выключении.",
                "pt": "Corrigir reinicializações repetidas de normalização de políticas e corridas de desligamento",
                "nl": "Herstart van herhaalde beleidsnormalisatie-herstarts en shutdown-races",
                "fr": "Correction des redémarrages répétés de normalisation des politiques et des courses à l'arrêt",
                "it": "Correggi i ripetuti riavvii di normalizzazione delle politiche e le gare di arresto",
                "es": "Corregir reinicios repetidos de normalización de políticas y carreras de cierre",
                "pl": "Napraw powtarzające się ponowne uruchamianie normalizacji zasad i wyścigi zamykania",
                "uk": "Виправлення повторних перезапусків нормалізації політики та гонок завершення роботи",
