{
    "i18n": true,
    "type": "panel",
    "items": {
        "notice": {
            "type": "staticText",
            "text": "This policy is synchronized with SmartBrain's Devices / States table. All permissions default to off; Control remains deny-by-default and requires the complete permission chain.",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 12,
            "lg": 12,
            "xl": 12
        },
        "semanticType": {
            "type": "select",
            "label": "Semantic type",
            "default": "auto",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6,
            "options": [
                {
                    "label": "Auto",
                    "value": "auto"
                },
                {
                    "label": "Light",
                    "value": "light"
                },
                {
                    "label": "Dimmer",
                    "value": "dimmer"
                },
                {
                    "label": "Motion",
                    "value": "motion"
                },
                {
                    "label": "Presence",
                    "value": "presence"
                },
                {
                    "label": "Illuminance",
                    "value": "illuminance"
                },
                {
                    "label": "Temperature",
                    "value": "temperature"
                },
                {
                    "label": "Humidity",
                    "value": "humidity"
                },
                {
                    "label": "Cloud cover",
                    "value": "cloudCover"
                },
                {
                    "label": "Precipitation",
                    "value": "precipitation"
                },
                {
                    "label": "Wind speed",
                    "value": "windSpeed"
                },
                {
                    "label": "Contact",
                    "value": "contact"
                },
                {
                    "label": "Lock",
                    "value": "lock"
                },
                {
                    "label": "Alarm",
                    "value": "alarm"
                },
                {
                    "label": "Switch",
                    "value": "switch"
                },
                {
                    "label": "Unknown",
                    "value": "unknown"
                }
            ]
        },
        "scope": {
            "type": "select",
            "label": "Scope",
            "help": "Choose Room related when local pattern learning requires a room, or Global for intentional whole-home and context states.",
            "default": "auto",
            "xs": 12,
            "sm": 12,
            "md": 6,
            "lg": 6,
            "xl": 6,
            "options": [
                {
                    "label": "Automatic scope",
                    "value": "auto"
                },
                {
                    "label": "Room related",
                    "value": "room"
                },
                {
                    "label": "Global",
                    "value": "global"
                }
            ]
        },
        "observe": {
            "type": "checkbox",
            "label": "Observe",
            "default": false,
            "newLine": true,
            "xs": 12,
            "sm": 6,
            "md": 3,
            "lg": 3,
            "xl": 3
        },
        "learn": {
            "type": "checkbox",
            "label": "Learn",
            "default": false,
            "xs": 12,
            "sm": 6,
            "md": 3,
            "lg": 3,
            "xl": 3
        },
        "suggest": {
            "type": "checkbox",
            "label": "Suggest target",
            "help": "Only required when this state may be the target of a proposed action; trigger and context sources need only Learn.",
            "default": false,
            "xs": 12,
            "sm": 6,
            "md": 3,
            "lg": 3,
            "xl": 3
        },
        "control": {
            "type": "checkbox",
            "label": "Control",
            "default": false,
            "xs": 12,
            "sm": 6,
            "md": 3,
            "lg": 3,
            "xl": 3
        }
    }
}
