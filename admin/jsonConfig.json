{
    "i18n": true,
    "type": "tabs",
    "items": {
        "overview": {
            "type": "panel",
            "label": "Overview",
            "items": {
                "phaseNotice": {
                    "type": "staticText",
                    "text": "Controlled actions are deny-by-default. Level 3 still requires an eligible approved pattern, explicit Control permission, current conditions, confidence, writable metadata, and all safety checks. Level 0 is the installation default.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "discoveryStatus": {
                    "type": "state",
                    "label": "Discovery status",
                    "oid": "discovery.status",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "scannedStates": {
                    "type": "state",
                    "label": "Scanned states",
                    "oid": "discovery.scannedStateCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "classifiedStates": {
                    "type": "state",
                    "label": "Classified states",
                    "oid": "discovery.classifiedStateCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "unknownStates": {
                    "type": "state",
                    "label": "Unknown states",
                    "oid": "discovery.unknownStateCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "subscribedStates": {
                    "type": "state",
                    "label": "Observed states",
                    "oid": "observation.subscribedStateCount",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "retainedObservations": {
                    "type": "state",
                    "label": "Buffered observations",
                    "oid": "observation.retainedCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "historyProvider": {
                    "type": "state",
                    "label": "History provider",
                    "oid": "history.activeProvider",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "historyQueries": {
                    "type": "state",
                    "label": "History queries",
                    "oid": "history.queryCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "autonomyLevel": {
                    "type": "select",
                    "label": "Autonomy level",
                    "options": [
                        {
                            "label": "Level 0 - Observe only",
                            "value": 0
                        },
                        {
                            "label": "Level 1 - Learn and suggest",
                            "value": 1
                        },
                        {
                            "label": "Level 2 - Individual approval",
                            "value": 2
                        },
                        {
                            "label": "Level 3 - Controlled automatic execution",
                            "value": 3
                        }
                    ],
                    "help": "The autonomy level limits what Freya may do. Learning and state permissions are configured separately.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "learningEnabled": {
                    "type": "checkbox",
                    "label": "Enable learning",
                    "help": "Read-only learning for states with explicit Learn permission",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "historyInstance": {
                    "type": "selectSendTo",
                    "label": "History provider",
                    "command": "getHistoryProviderOptions",
                    "manual": false,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "minimumActionConfidence": {
                    "type": "number",
                    "label": "Minimum action confidence",
                    "min": 0.58,
                    "max": 1,
                    "step": 0.01,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "actionCooldownSeconds": {
                    "type": "number",
                    "label": "Target cooldown (seconds)",
                    "min": 5,
                    "max": 86400,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "blockedStateIds": {
                    "type": "table",
                    "label": "Always blocked targets",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8,
                    "items": [
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "State",
                            "types": ["state"],
                            "filter": false,
                            "sort": false
                        }
                    ]
                }
            }
        },
        "states": {
            "type": "panel",
            "label": "Devices / States",
            "items": {
                "discoveryEnabled": {
                    "type": "checkbox",
                    "label": "Enable metadata discovery",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "discoveryMaxStates": {
                    "type": "number",
                    "label": "Maximum states per scan",
                    "min": 100,
                    "max": 50000,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "policyNotice": {
                    "type": "staticText",
                    "text": "All permissions default to off. Control requires Observe, Learn, and Suggest and is used only by the controlled Action Executor. Locks and security states remain denied.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "statePolicies": {
                    "type": "table",
                    "label": "State permissions and semantic corrections",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "State",
                            "types": ["state"],
                            "width": "25%",
                            "filter": false,
                            "sort": false
                        },
                        {
                            "type": "select",
                            "attr": "semanticType",
                            "title": "Semantic type",
                            "width": "14%",
                            "default": "auto",
                            "options": [
                                {
                                    "label": "Auto",
                                    "value": "auto"
                                },
                                {
                                    "label": "Light",
                                    "value": "light"
                                },
                                {
                                    "label": "Dimmer",
                                    "value": "dimmer"
                                },
                                {
                                    "label": "Motion",
                                    "value": "motion"
                                },
                                {
                                    "label": "Presence",
                                    "value": "presence"
                                },
                                {
                                    "label": "Illuminance",
                                    "value": "illuminance"
                                },
                                {
                                    "label": "Temperature",
                                    "value": "temperature"
                                },
                                {
                                    "label": "Humidity",
                                    "value": "humidity"
                                },
                                {
                                    "label": "Cloud cover",
                                    "value": "cloudCover"
                                },
                                {
                                    "label": "Precipitation",
                                    "value": "precipitation"
                                },
                                {
                                    "label": "Wind speed",
                                    "value": "windSpeed"
                                },
                                {
                                    "label": "Contact",
                                    "value": "contact"
                                },
                                {
                                    "label": "Lock",
                                    "value": "lock"
                                },
                                {
                                    "label": "Alarm",
                                    "value": "alarm"
                                },
                                {
                                    "label": "Switch",
                                    "value": "switch"
                                },
                                {
                                    "label": "Unknown",
                                    "value": "unknown"
                                }
                            ]
                        },
                        {
                            "type": "select",
                            "attr": "scope",
                            "title": "Scope",
                            "width": "12%",
                            "default": "auto",
                            "options": [
                                {
                                    "label": "Automatic scope",
                                    "value": "auto"
                                },
                                {
                                    "label": "Room related",
                                    "value": "room"
                                },
                                {
                                    "label": "Global",
                                    "value": "global"
                                }
                            ]
                        },
                        {
                            "type": "text",
                            "attr": "roomAssignment",
                            "title": "Rooms",
                            "width": "17%",
                            "readOnly": true,
                            "doNotSave": true
                        },
                        {
                            "type": "checkbox",
                            "attr": "observe",
                            "title": "Observe",
                            "width": "8%",
                            "default": false
                        },
                        {
                            "type": "checkbox",
                            "attr": "learn",
                            "title": "Learn",
                            "width": "8%",
                            "default": false
                        },
                        {
                            "type": "checkbox",
                            "attr": "suggest",
                            "title": "Suggest target",
                            "width": "8%",
                            "default": false
                        },
                        {
                            "type": "checkbox",
                            "attr": "control",
                            "title": "Control",
                            "width": "8%",
                            "default": false
                        }
                    ]
                },
                "roomDiagnosticsNotice": {
                    "type": "staticText",
                    "text": "Room status shows a warning only when a learned room-relevant state has no room and its scope is not explicitly Global. Assign a room or choose Global for intentional whole-home states.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_refreshRoomDiagnostics": {
                    "type": "sendTo",
                    "label": "Refresh room status",
                    "command": "getRoomDiagnostics",
                    "useNative": true,
                    "onLoaded": true,
                    "variant": "outlined",
                    "icon": "refresh",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "environment": {
            "type": "panel",
            "label": "Environment mappings",
            "items": {
                "environmentNotice": {
                    "type": "staticText",
                    "text": "Mappings use semantic keys and may contain several prioritized sources. No adapter-specific state IDs are hard-coded.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "environmentMappings": {
                    "type": "table",
                    "label": "Manual source priorities",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "select",
                            "attr": "key",
                            "title": "Semantic key",
                            "width": "28%",
                            "options": [
                                {
                                    "label": "Outside temperature",
                                    "value": "outsideTemperature"
                                },
                                {
                                    "label": "Outside illuminance",
                                    "value": "outsideIlluminance"
                                },
                                {
                                    "label": "Humidity",
                                    "value": "humidity"
                                },
                                {
                                    "label": "Cloud cover",
                                    "value": "cloudCover"
                                },
                                {
                                    "label": "Precipitation",
                                    "value": "precipitation"
                                },
                                {
                                    "label": "Wind speed",
                                    "value": "windSpeed"
                                }
                            ]
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "Source state",
                            "types": ["state"],
                            "width": "45%",
                            "filter": false,
                            "sort": false
                        },
                        {
                            "type": "number",
                            "attr": "priority",
                            "title": "Priority",
                            "width": "14%",
                            "default": 0,
                            "min": -100,
                            "max": 100
                        },
                        {
                            "type": "checkbox",
                            "attr": "pinned",
                            "title": "Pinned",
                            "width": "10%",
                            "default": false
                        }
                    ]
                },
                "manualLatitude": {
                    "type": "number",
                    "label": "Manual latitude override",
                    "help": "Leave empty to use ioBroker system coordinates",
                    "min": -90,
                    "max": 90,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "manualLongitude": {
                    "type": "number",
                    "label": "Manual longitude override",
                    "help": "Both manual values are required for an override",
                    "min": -180,
                    "max": 180,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "patterns": {
            "type": "panel",
            "label": "Patterns",
            "items": {
                "patternNotice": {
                    "type": "staticText",
                    "text": "Learn allows a state to contribute as a trigger or context source. Suggest applies only when the state is the proposed action target. Approval never grants Control permission; execution additionally requires level 3 and every current safety check.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "patternRows": {
                    "type": "table",
                    "label": "Learned patterns",
                    "doNotSave": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "status",
                            "title": "Status",
                            "width": "8%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "eligible",
                            "title": "Eligible",
                            "width": "5%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "rooms",
                            "title": "Rooms",
                            "width": "10%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "trigger",
                            "title": "Trigger",
                            "width": "16%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "target",
                            "title": "Target",
                            "width": "16%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "action",
                            "title": "Action",
                            "width": "6%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "confidence",
                            "title": "Confidence",
                            "width": "7%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "evidence",
                            "title": "Evidence",
                            "width": "7%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "explanation",
                            "title": "Explanation",
                            "width": "25%",
                            "readOnly": true
                        }
                    ]
                },
                "_refreshPatterns": {
                    "type": "sendTo",
                    "label": "Refresh patterns",
                    "command": "getPatternAdminData",
                    "useNative": true,
                    "onLoaded": true,
                    "variant": "outlined",
                    "icon": "refresh",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_selectedPattern": {
                    "type": "selectSendTo",
                    "label": "Selected pattern",
                    "command": "getPatternOptions",
                    "manual": false,
                    "doNotSave": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 9,
                    "lg": 9,
                    "xl": 9
                },
                "_approvePattern": {
                    "type": "sendTo",
                    "label": "Approve pattern",
                    "command": "setPatternStatus",
                    "jsonData": "{\"patternId\":\"${data._selectedPattern}\",\"status\":\"approved\"}",
                    "disabled": "!data._selectedPattern",
                    "variant": "contained",
                    "color": "primary",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_disablePattern": {
                    "type": "sendTo",
                    "label": "Disable pattern",
                    "command": "setPatternStatus",
                    "jsonData": "{\"patternId\":\"${data._selectedPattern}\",\"status\":\"disabled\"}",
                    "disabled": "!data._selectedPattern",
                    "variant": "outlined",
                    "color": "secondary",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_executePattern": {
                    "type": "sendTo",
                    "label": "Execute once",
                    "command": "executePattern",
                    "jsonData": "{\"patternId\":\"${data._selectedPattern}\"}",
                    "disabled": "!data._selectedPattern",
                    "confirm": {
                        "text": "Execute the selected approved pattern once after all current safety checks?",
                        "title": "Confirm execution",
                        "ok": "Execute",
                        "cancel": "Cancel"
                    },
                    "variant": "outlined",
                    "color": "warning",
                    "xs": 12,
                    "sm": 4,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "pendingActionsHeader": {
                    "type": "header",
                    "text": "Pending one-shot actions",
                    "size": 4,
                    "newLine": true
                },
                "pendingActionRows": {
                    "type": "table",
                    "label": "Action proposals",
                    "doNotSave": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "status",
                            "title": "Status",
                            "width": "8%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "rooms",
                            "title": "Rooms",
                            "width": "10%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "trigger",
                            "title": "Trigger",
                            "width": "18%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "target",
                            "title": "Target",
                            "width": "18%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "action",
                            "title": "Action",
                            "width": "7%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "confidence",
                            "title": "Confidence",
                            "width": "8%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "expires",
                            "title": "Expires",
                            "width": "14%",
                            "readOnly": true
                        },
                        {
                            "type": "text",
                            "attr": "result",
                            "title": "Result",
                            "width": "17%",
                            "readOnly": true
                        }
                    ]
                },
                "_refreshPendingActions": {
                    "type": "sendTo",
                    "label": "Refresh action proposals",
                    "command": "getPendingActionAdminData",
                    "useNative": true,
                    "onLoaded": true,
                    "variant": "outlined",
                    "icon": "refresh",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_selectedPendingAction": {
                    "type": "selectSendTo",
                    "label": "Selected action proposal",
                    "command": "getPendingActionOptions",
                    "manual": false,
                    "doNotSave": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 9,
                    "lg": 9,
                    "xl": 9
                },
                "_approvePendingAction": {
                    "type": "sendTo",
                    "label": "Approve and execute once",
                    "command": "approvePendingAction",
                    "jsonData": "{\"pendingActionId\":\"${data._selectedPendingAction}\"}",
                    "disabled": "!data._selectedPendingAction",
                    "confirm": {
                        "text": "Approve this exact action proposal and execute it once after all current safety checks?",
                        "title": "Confirm one-shot action",
                        "ok": "Approve and execute",
                        "cancel": "Cancel"
                    },
                    "variant": "contained",
                    "color": "primary",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_rejectPendingAction": {
                    "type": "sendTo",
                    "label": "Reject action proposal",
                    "command": "rejectPendingAction",
                    "jsonData": "{\"pendingActionId\":\"${data._selectedPendingAction}\"}",
                    "disabled": "!data._selectedPendingAction",
                    "variant": "outlined",
                    "color": "secondary",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "candidatePatterns": {
                    "type": "state",
                    "label": "Candidate patterns",
                    "oid": "suggestions.candidateCount",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "approvedPatterns": {
                    "type": "state",
                    "label": "Approved patterns",
                    "oid": "patterns.approvedCount",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "disabledPatterns": {
                    "type": "state",
                    "label": "Disabled patterns",
                    "oid": "patterns.disabledCount",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "latestSuggestion": {
                    "type": "state",
                    "label": "Latest explanation",
                    "oid": "suggestions.latest",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "llm": {
            "type": "panel",
            "label": "Optional LLM",
            "items": {
                "llmNotice": {
                    "type": "staticText",
                    "text": "LLMs are advisory only and cannot authorize or execute actions. Rules Only is local and is the default. External analysis is sent only by an explicit Admin request and contains allow-listed aggregates without state IDs, room names, raw values, or persons. Use previewLlmDisclosure to inspect the exact payload first.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "llmProvider": {
                    "type": "select",
                    "label": "Provider",
                    "options": [
                        {
                            "label": "Disabled",
                            "value": "disabled"
                        },
                        {
                            "label": "Rules Only (local)",
                            "value": "rules"
                        },
                        {
                            "label": "Ollama",
                            "value": "ollama"
                        },
                        {
                            "label": "OpenAI",
                            "value": "openai"
                        },
                        {
                            "label": "OpenAI-compatible",
                            "value": "openai-compatible"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmModel": {
                    "type": "text",
                    "label": "Model",
                    "help": "Required for Ollama, OpenAI, and compatible providers; no model is silently substituted",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmTimeoutSeconds": {
                    "type": "number",
                    "label": "Timeout (seconds)",
                    "min": 1,
                    "max": 60,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmBaseUrl": {
                    "type": "text",
                    "label": "Base URL",
                    "help": "Ollama accepts loopback HTTP only; compatible remote providers require HTTPS",
                    "newLine": true,
