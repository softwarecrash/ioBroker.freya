{
    "i18n": false,
    "type": "tabs",
    "items": {
        "overview": {
            "type": "panel",
            "label": { "en": "Overview", "de": "Übersicht" },
            "items": {
                "phaseNotice": {
                    "type": "staticText",
                    "text": {
                        "en": "Controlled actions are deny-by-default. Level 3 still requires an eligible approved pattern, explicit Control permission, current conditions, confidence, writable metadata, and all safety checks. Level 0 is the installation default.",
                        "de": "Kontrollierte Aktionen sind standardmäßig gesperrt. Stufe 3 benötigt weiterhin ein geeignetes freigegebenes Muster, explizite Control-Berechtigung, aktuelle Bedingungen, Confidence, schreibbare Metadaten und alle Sicherheitsprüfungen. Installationsstandard ist Stufe 0."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "discoveryStatus": {
                    "type": "state",
                    "label": { "en": "Discovery status", "de": "Erkennungsstatus" },
                    "oid": "discovery.status",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "scannedStates": {
                    "type": "state",
                    "label": { "en": "Scanned states", "de": "Gescannte States" },
                    "oid": "discovery.scannedStateCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "classifiedStates": {
                    "type": "state",
                    "label": { "en": "Classified states", "de": "Klassifizierte States" },
                    "oid": "discovery.classifiedStateCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "unknownStates": {
                    "type": "state",
                    "label": { "en": "Unknown states", "de": "Unbekannte States" },
                    "oid": "discovery.unknownStateCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "subscribedStates": {
                    "type": "state",
                    "label": { "en": "Observed states", "de": "Beobachtete States" },
                    "oid": "observation.subscribedStateCount",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "retainedObservations": {
                    "type": "state",
                    "label": { "en": "Buffered observations", "de": "Gepufferte Beobachtungen" },
                    "oid": "observation.retainedCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "historyProvider": {
                    "type": "state",
                    "label": { "en": "History provider", "de": "History-Provider" },
                    "oid": "history.activeProvider",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "historyQueries": {
                    "type": "state",
                    "label": { "en": "History queries", "de": "History-Abfragen" },
                    "oid": "history.queryCount",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "autonomyLevel": {
                    "type": "number",
                    "label": { "en": "Autonomy level", "de": "Autonomie-Level" },
                    "min": 0,
                    "max": 3,
                    "help": {
                        "en": "0 observe, 1 learn/suggest, 2 reserved for per-action approval, 3 controlled execution of approved patterns",
                        "de": "0 beobachten, 1 lernen/vorschlagen, 2 für Einzel-Freigaben reserviert, 3 kontrollierte Ausführung freigegebener Muster"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "learningEnabled": {
                    "type": "checkbox",
                    "label": { "en": "Enable learning", "de": "Lernen aktivieren" },
                    "help": {
                        "en": "Read-only learning for states with explicit Learn permission",
                        "de": "Schreibgeschütztes Lernen nur für States mit expliziter Lernberechtigung"
                    },
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "historyInstance": {
                    "type": "selectSendTo",
                    "label": { "en": "History provider", "de": "History-Provider" },
                    "command": "getHistoryProviderOptions",
                    "manual": false,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "minimumActionConfidence": {
                    "type": "number",
                    "label": { "en": "Minimum action confidence", "de": "Minimale Aktions-Confidence" },
                    "min": 0.58,
                    "max": 1,
                    "step": 0.01,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "actionCooldownSeconds": {
                    "type": "number",
                    "label": { "en": "Target cooldown (seconds)", "de": "Ziel-Cooldown (Sekunden)" },
                    "min": 5,
                    "max": 86400,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "blockedStateIds": {
                    "type": "table",
                    "label": { "en": "Always blocked targets", "de": "Immer gesperrte Ziele" },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8,
                    "items": [
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": { "en": "State", "de": "State" },
                            "types": ["state"],
                            "filter": false,
                            "sort": false
                        }
                    ]
                }
            }
        },
        "states": {
            "type": "panel",
            "label": { "en": "Devices / States", "de": "Geräte / States" },
            "items": {
                "discoveryEnabled": {
                    "type": "checkbox",
                    "label": { "en": "Enable metadata discovery", "de": "Metadaten-Erkennung aktivieren" },
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "discoveryMaxStates": {
                    "type": "number",
                    "label": { "en": "Maximum states per scan", "de": "Maximale States pro Scan" },
                    "min": 100,
                    "max": 50000,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "policyNotice": {
                    "type": "staticText",
                    "text": {
                        "en": "All permissions default to off. Control requires Observe, Learn, and Suggest and is used only by the controlled Action Executor. Locks and security states remain denied.",
                        "de": "Alle Berechtigungen sind standardmäßig aus. Control benötigt Observe, Learn und Suggest und wird nur vom kontrollierten Action Executor verwendet. Schlösser und Sicherheits-States bleiben gesperrt."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "statePolicies": {
                    "type": "table",
                    "label": {
                        "en": "State permissions and semantic corrections",
                        "de": "State-Berechtigungen und semantische Korrekturen"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": { "en": "State", "de": "State" },
                            "types": ["state"],
                            "width": "32%",
                            "filter": false,
                            "sort": false
                        },
                        {
                            "type": "select",
                            "attr": "semanticType",
                            "title": { "en": "Semantic type", "de": "Semantischer Typ" },
                            "width": "18%",
                            "default": "auto",
                            "options": [
                                { "label": "Auto", "value": "auto" },
                                { "label": "Light", "value": "light" },
                                { "label": "Dimmer", "value": "dimmer" },
                                { "label": "Motion", "value": "motion" },
                                { "label": "Presence", "value": "presence" },
                                { "label": "Illuminance", "value": "illuminance" },
                                { "label": "Temperature", "value": "temperature" },
                                { "label": "Humidity", "value": "humidity" },
                                { "label": "Cloud cover", "value": "cloudCover" },
                                { "label": "Precipitation", "value": "precipitation" },
                                { "label": "Wind speed", "value": "windSpeed" },
                                { "label": "Contact", "value": "contact" },
                                { "label": "Lock", "value": "lock" },
                                { "label": "Alarm", "value": "alarm" },
                                { "label": "Switch", "value": "switch" },
                                { "label": "Unknown", "value": "unknown" }
                            ]
                        },
                        { "type": "checkbox", "attr": "observe", "title": "Observe", "width": "8%", "default": false },
                        { "type": "checkbox", "attr": "learn", "title": "Learn", "width": "8%", "default": false },
                        { "type": "checkbox", "attr": "suggest", "title": "Suggest", "width": "8%", "default": false },
                        { "type": "checkbox", "attr": "control", "title": "Control", "width": "8%", "default": false }
                    ]
                }
            }
        },
        "environment": {
            "type": "panel",
            "label": { "en": "Environment mappings", "de": "Umgebungs-Zuordnungen" },
            "items": {
                "environmentNotice": {
                    "type": "staticText",
                    "text": {
                        "en": "Mappings use semantic keys and may contain several prioritized sources. No adapter-specific state IDs are hard-coded.",
                        "de": "Zuordnungen verwenden semantische Schlüssel und können mehrere priorisierte Quellen enthalten. Es sind keine adapterspezifischen State-IDs fest codiert."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "environmentMappings": {
                    "type": "table",
                    "label": { "en": "Manual source priorities", "de": "Manuelle Quellenprioritäten" },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "select",
                            "attr": "key",
                            "title": { "en": "Semantic key", "de": "Semantischer Schlüssel" },
                            "width": "28%",
                            "options": [
                                { "label": "Outside temperature", "value": "outsideTemperature" },
                                { "label": "Outside illuminance", "value": "outsideIlluminance" },
                                { "label": "Humidity", "value": "humidity" },
                                { "label": "Cloud cover", "value": "cloudCover" },
                                { "label": "Precipitation", "value": "precipitation" },
                                { "label": "Wind speed", "value": "windSpeed" }
                            ]
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": { "en": "Source state", "de": "Quell-State" },
                            "types": ["state"],
                            "width": "45%",
                            "filter": false,
                            "sort": false
                        },
                        {
                            "type": "number",
                            "attr": "priority",
                            "title": { "en": "Priority", "de": "Priorität" },
                            "width": "14%",
                            "default": 0,
                            "min": -100,
                            "max": 100
                        },
                        {
                            "type": "checkbox",
                            "attr": "pinned",
                            "title": { "en": "Pinned", "de": "Fixiert" },
                            "width": "10%",
                            "default": false
                        }
                    ]
                },
                "manualLatitude": {
                    "type": "number",
                    "label": { "en": "Manual latitude override", "de": "Manueller Breitengrad" },
                    "help": {
                        "en": "Leave empty to use ioBroker system coordinates",
                        "de": "Leer lassen, um die ioBroker-Systemkoordinaten zu verwenden"
                    },
                    "min": -90,
                    "max": 90,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "manualLongitude": {
                    "type": "number",
                    "label": { "en": "Manual longitude override", "de": "Manueller Längengrad" },
                    "help": {
                        "en": "Both manual values are required for an override",
                        "de": "Für eine manuelle Übersteuerung sind beide Werte erforderlich"
                    },
                    "min": -180,
                    "max": 180,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "patterns": {
            "type": "panel",
            "label": { "en": "Patterns", "de": "Muster" },
            "items": {
                "patternNotice": {
                    "type": "staticText",
                    "text": {
                        "en": "Suggestions require explicit Suggest permission on both trigger and light. Approve/disable transitions are accepted only from ioBroker Admin and never grant Control permission. Execution additionally requires level 3 and every current safety check.",
                        "de": "Vorschläge benötigen die explizite Vorschlagsberechtigung für Auslöser und Licht. Freigabe-/Deaktivierungswechsel werden nur vom ioBroker-Admin angenommen und vergeben niemals eine Steuerungsberechtigung. Ausführung benötigt zusätzlich Stufe 3 und alle aktuellen Sicherheitsprüfungen."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "candidatePatterns": {
                    "type": "state",
                    "label": { "en": "Candidate patterns", "de": "Musterkandidaten" },
                    "oid": "suggestions.candidateCount",
                    "newLine": true,
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "approvedPatterns": {
                    "type": "state",
                    "label": { "en": "Approved patterns", "de": "Freigegebene Muster" },
                    "oid": "patterns.approvedCount",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "disabledPatterns": {
                    "type": "state",
                    "label": { "en": "Disabled patterns", "de": "Deaktivierte Muster" },
                    "oid": "patterns.disabledCount",
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "latestSuggestion": {
                    "type": "state",
                    "label": { "en": "Latest explanation", "de": "Letzte Erklärung" },
                    "oid": "suggestions.latest",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "llm": {
            "type": "panel",
            "label": { "en": "Optional LLM", "de": "Optionales LLM" },
            "items": {
                "llmNotice": {
                    "type": "staticText",
                    "text": {
                        "en": "LLMs are advisory only and cannot authorize or execute actions. Rules Only is local and is the default. External analysis is sent only by an explicit Admin request and contains allow-listed aggregates without state IDs, room names, raw values, or persons. Use previewLlmDisclosure to inspect the exact payload first.",
                        "de": "LLMs beraten nur und können Aktionen weder autorisieren noch ausführen. Rules Only ist lokal und Standard. Externe Analyse wird nur durch eine explizite Admin-Anfrage gesendet und enthält ausschließlich freigegebene Aggregate ohne State-IDs, Raumnamen, Rohwerte oder Personen. Mit previewLlmDisclosure kann die exakte Nutzlast vorher geprüft werden."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "llmProvider": {
                    "type": "select",
                    "label": { "en": "Provider", "de": "Provider" },
                    "options": [
                        { "label": { "en": "Disabled", "de": "Deaktiviert" }, "value": "disabled" },
                        { "label": { "en": "Rules Only (local)", "de": "Nur Regeln (lokal)" }, "value": "rules" },
                        { "label": "Ollama", "value": "ollama" },
                        { "label": "OpenAI", "value": "openai" },
                        { "label": "OpenAI-compatible", "value": "openai-compatible" }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmModel": {
                    "type": "text",
                    "label": { "en": "Model", "de": "Modell" },
                    "help": {
                        "en": "Required for Ollama, OpenAI, and compatible providers; no model is silently substituted",
                        "de": "Für Ollama, OpenAI und kompatible Provider erforderlich; es wird kein Modell stillschweigend ersetzt"
                    },
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmTimeoutSeconds": {
                    "type": "number",
                    "label": { "en": "Timeout (seconds)", "de": "Timeout (Sekunden)" },
                    "min": 1,
                    "max": 60,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmBaseUrl": {
                    "type": "text",
                    "label": { "en": "Base URL", "de": "Basis-URL" },
                    "help": {
                        "en": "Ollama accepts loopback HTTP only; compatible remote providers require HTTPS",
                        "de": "Ollama akzeptiert nur Loopback-HTTP; kompatible entfernte Provider benötigen HTTPS"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 8,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "llmApiKey": {
                    "type": "password",
                    "label": { "en": "API key", "de": "API-Schlüssel" },
                    "help": {
                        "en": "Stored in protected and encrypted native configuration; never logged or included in previews",
                        "de": "Wird geschützt und verschlüsselt in der nativen Konfiguration gespeichert; erscheint nie in Logs oder Vorschauen"
                    },
                    "xs": 12,
                    "sm": 4,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmEffectiveProvider": {
                    "type": "state",
                    "label": { "en": "Effective provider", "de": "Effektiver Provider" },
                    "oid": "llm.provider",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmExternal": {
                    "type": "state",
                    "label": { "en": "External disclosure enabled", "de": "Externe Übertragung aktiv" },
                    "oid": "llm.external",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "llmLastResult": {
                    "type": "state",
                    "label": { "en": "Last advisory result", "de": "Letztes Beratungsergebnis" },
                    "oid": "llm.lastResult",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "activity": {
            "type": "panel",
            "label": { "en": "Activity", "de": "Aktivität" },
            "items": {
                "activityNotice": {
                    "type": "staticText",
                    "text": {
                        "en": "Candidate creation, withdrawal, accepted status changes, and rejected commands are retained in a bounded in-memory audit log. Detailed pages are available through getActivity.",
                        "de": "Kandidatenerstellung, Rücknahme, akzeptierte Statuswechsel und abgewiesene Befehle werden in einem begrenzten Audit-Protokoll im Arbeitsspeicher gehalten. Detailseiten sind über getActivity verfügbar."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "activityCount": {
                    "type": "state",
                    "label": { "en": "Activity records", "de": "Aktivitätseinträge" },
                    "oid": "activity.count",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "lastActivity": {
                    "type": "state",
                    "label": { "en": "Last activity timestamp", "de": "Letzte Aktivität" },
                    "oid": "activity.lastTimestamp",
                    "xs": 12,
                    "sm": 6,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "actionAuditCount": {
                    "type": "state",
                    "label": { "en": "Action audit records", "de": "Aktions-Audit-Einträge" },
                    "oid": "actions.auditCount",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "lastActionResult": {
                    "type": "state",
                    "label": { "en": "Last action result", "de": "Letztes Aktionsergebnis" },
                    "oid": "actions.lastResult",
                    "xs": 12,
                    "sm": 6,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        }
    }
}
